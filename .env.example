# ============================================================
#  LTIC SARL — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit the real .env to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://ltic_user:strongpassword@localhost:5432/ltic_sarl

# ── Admin ────────────────────────────────────────────────────
# Used only on first startup to seed the admin account.
# Change credentials from the My Profile page after first login.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe123!

# ── Security ─────────────────────────────────────────────────
# MUST be at least 32 characters. Use: openssl rand -hex 32
SESSION_SECRET=replace-this-with-a-32-character-or-longer-random-string

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── URLs ─────────────────────────────────────────────────────
# Your public domain (no trailing slash). Used for:
#   - CORS origin whitelist (API)
#   - Tracking links in order emails
#   - Open Graph / canonical URL (frontend)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# URL of the API as seen by the browser (no trailing slash).
# On VPS with Nginx reverse-proxy this is the same as NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_API_URL=https://www.yourdomain.com

# ── Email / SMTP ─────────────────────────────────────────────
# Leave all MAIL_* blank to disable emails (site still works without them).
#
# Option 1 — Gmail (free, 500 emails/day)
#   Enable "App Passwords" in your Google account, then:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SECURE=false
#   MAIL_USER=your-gmail@gmail.com
#   MAIL_PASS=xxxx-xxxx-xxxx-xxxx   ← 16-char App Password
#
# Option 2 — Brevo / Sendinblue (free tier: 300 emails/day)
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_SECURE=false
#   MAIL_USER=your-brevo-login@email.com
#   MAIL_PASS=your-brevo-smtp-key
#
# Option 3 — Hostinger Email (if you buy the email add-on ~$1.99/mo)
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_SECURE=true
#   MAIL_USER=noreply@yourdomain.com
#   MAIL_PASS=your-hostinger-email-password
#
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@yourdomain.com

# Admin email — receives quote and contact notifications
ADMIN_EMAIL_NOTIFY=admin@yourdomain.com
